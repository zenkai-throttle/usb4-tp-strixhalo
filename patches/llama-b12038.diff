+// read uncached (write-combined) UMA memory with streaming loads (GGML_VK_UMA_READ_STREAM=1)
+static void ggml_vk_uma_read(void * dst, const void * src, size_t n, bool uncached) {
+#if defined(__SSE4_1__)
+    static const bool stream = getenv("GGML_VK_UMA_READ_STREAM") != nullptr;
+    if (stream && uncached && n >= 64 && ((uintptr_t) src % 16) == ((uintptr_t) dst % 16)) {
+        uint8_t * d = (uint8_t *) dst;
+        const uint8_t * s = (const uint8_t *) src;
+        const size_t head = (16 - ((uintptr_t) s % 16)) % 16;
+        memcpy(d, s, head); d += head; s += head; n -= head;
+        size_t i = 0;
+        for (; i + 64 <= n; i += 64) {
+            __m128i a = _mm_stream_load_si128((__m128i *) (s + i));
+            __m128i b = _mm_stream_load_si128((__m128i *) (s + i + 16));
+            __m128i c = _mm_stream_load_si128((__m128i *) (s + i + 32));
+            __m128i e = _mm_stream_load_si128((__m128i *) (s + i + 48));
+            _mm_store_si128((__m128i *) (d + i), a);
+            _mm_store_si128((__m128i *) (d + i + 16), b);
+            _mm_store_si128((__m128i *) (d + i + 32), c);
+            _mm_store_si128((__m128i *) (d + i + 48), e);
+        }
+        memcpy(d + i, s + i, n - i);
+        return;
+    }
+#else
+    (void) uncached;
+#endif
+    memcpy(dst, src, n);
+}
 
